# Copy this file to .env.local and fill in real values from your Clerk dashboard.
# NEVER commit your real .env.local.

# Clerk publishable (frontend) key (starts with pk_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk secret (backend) key (starts with sk_)
CLERK_SECRET_KEY=sk_test_replace_me

# Admin access control (optional - if not set, all authenticated users have access)
NEXT_PUBLIC_ALLOWED_EMAIL=admin@example.com
NEXT_PUBLIC_ALLOWED_PHONE=+15551234567
